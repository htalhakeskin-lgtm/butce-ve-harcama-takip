# Copy to .env.local for local development. Every value is read through src/env.ts.

# --- App identity (K-18: the name and address are not fixed yet) ---
NEXT_PUBLIC_APP_NAME="Bütçe"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database ---
# Local: docker compose up -d  (see docker-compose.yml)
DATABASE_URL="postgres://butce:butce@localhost:5433/butce"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me-to-a-32-byte-random-secret"

# --- Email ---
# "file": emails are written to .dev-mail/ and listed at /dev/mail (local development, tests)
# "resend": emails are sent through Resend (requires RESEND_API_KEY and a verified domain)
EMAIL_TRANSPORT="file"
EMAIL_FROM="Bütçe <no-reply@example.com>"
RESEND_API_KEY=""

# --- Scheduled jobs (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=""
